RewriteEngine On

# TODO: Apache (XAMPP/MAMP) may hide the "Authorization: Bearer ..." header from PHP – pass it on


# Send every request that is not an existing file/folder to index.php (FlightPHP)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]
